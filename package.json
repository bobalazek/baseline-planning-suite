{
  "name": "baseline-planning-suite",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter './packages/*' build",
    "build:services": "pnpm --filter './services/*' build",
    "build:apps": "pnpm --filter './apps/*' build",
    "build": "pnpm build:packages && pnpm build:services && pnpm build:apps",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "pnpm --parallel --filter './apps/*' dev"
  },
  "devDependencies": {
    "@eslint/js": "9.40.0",
    "eslint": "9.40.0",
    "prettier": "3.7.4",
    "typescript": "7.0.2",
    "typescript-eslint": "9.0.1",
    "vitest": "5.0.0"
  }
}
