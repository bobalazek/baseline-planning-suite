# Nothing here is required. `docker compose up` works from a clean clone with no environment file
# at all — that is a hard constraint of the brief — and every variable below has a default in
# infrastructure/docker/compose.yml. Copy to .env only if you want to override one.

# The single exposed port.
BASELINE_PORT=8080

# Where the shell looks for each remote, written into /config.json by the shell container's
# entrypoint at start-up. This is the whole of "remote URLs resolve at runtime from container
# configuration, never from the bundle": point these somewhere else and restart, no rebuild.
PEOPLE_REMOTE_ENTRY=http://localhost:8080/remotes/people/mf-manifest.json
DELIVERY_REMOTE_ENTRY=http://localhost:8080/remotes/delivery/mf-manifest.json

# Log level for both domain services.
LOG_LEVEL=info
